# Text is normalised to LF in the repository and checked out CRLF on Windows,
# except for files a Linux box executes or a browser/tool reads byte-for-byte.
* text=auto eol=crlf

*.sh          text eol=lf
Dockerfile    text eol=lf
*.service     text eol=lf
*.desktop     text eol=lf
.github/**    text eol=lf

*.png   binary
*.ico   binary
*.icns  binary
*.woff2 binary
*.sqlite binary
*.lbdb  binary

# Fixtures whose exact bytes are the test (parsers, signatures).
crates/*/testdata/** -text
