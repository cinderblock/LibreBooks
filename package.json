{
  "name": "librebooks-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": ["web"],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun run --cwd web dev",
    "build": "bun run --cwd web build",
    "typecheck": "bun run --cwd web typecheck",
    "test": "bun run --cwd web test",
    "test:e2e": "bun run --cwd web test:e2e",
    "gen:types": "cargo test -p lb-core -p lb-store -p lb-reports -p lb-auth -p lb-feeds export_bindings"
  }
}
